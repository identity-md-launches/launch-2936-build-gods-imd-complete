{
  "name": "gods-of-imd",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Gods of IMD: a browser living-world RPG with 1,000 Genesis inhabitants.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "server": "tsx server/main.ts",
    "test:browser": "node --import tsx scripts/validate-browser.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22.13"
  }
}
